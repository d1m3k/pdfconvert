---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'pdf-to-jpg')!;
---
<ToolPage
  tool={tool}
  title="PDF to JPG — Convert PDF Pages to JPG Images Free | PdfConvert"
  description="Convert every PDF page into a high-quality JPG image in your browser. Choose 150, 200 or 300 DPI, download pages singly or as a ZIP. No uploads, no sign-up."
  lede="Turn each page of a PDF into a JPG you can paste into a document, post, or message — rendered at print-friendly resolutions."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Convert to JPG"
  initialStatus="Add a PDF file to convert."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> Every page will become one JPG image.',
    '<strong>Choose a resolution.</strong> 150 DPI suits screens, 200 DPI everyday printing, 300 DPI fine detail.',
    '<strong>Press Convert to JPG.</strong> Pages render one by one on your device, each with its own download button.',
    '<strong>Download</strong> single pages, or all of them together as a ZIP.',
  ]}
  goodToKnow="JPG suits pages full of photos and colour; pages that are mostly text with sharp lines stay crisper as PNG — there is a tool for that too. Higher DPI means bigger images and slower rendering on long documents, so start at 200 and only go higher if you need the detail."
  faqs={[
    { q: 'What DPI should I choose?', a: '150 for sharing on screen, 200 for office printing, 300 when small text must stay razor sharp. Most people never need more than 200.' },
    { q: 'Can I convert just one page?', a: 'Convert the whole document, then download only the page you need from the result list — every page gets its own button.' },
    { q: 'Will the images keep the page size?', a: 'Yes, pages render at their true proportions; the pixel size follows from the DPI you picked.' },
    { q: 'Is my PDF uploaded for conversion?', a: 'No. Rendering happens in your browser, on your device.' },
  ]}
>
  <div slot="options" class="options">
    <label>Resolution
      <select id="dpi">
        <option value="150">150 DPI · screen</option>
        <option value="200" selected>200 DPI · print</option>
        <option value="300">300 DPI · fine detail</option>
      </select>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/pdf-to-jpg.ts';</script>
