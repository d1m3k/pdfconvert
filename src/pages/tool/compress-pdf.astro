---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'compress-pdf')!;
---
<ToolPage
  tool={tool}
  title="Compress PDF — Shrink PDF Size Free, In Your Browser | PdfConvert"
  description="Compress a PDF for upload forms and email by rebuilding it at an efficient resolution, entirely in your browser. Honest levels, real before/after sizes, no uploads."
  lede="Get under that upload-form limit. Choose how hard to squeeze, see the exact before-and-after sizes, and keep the original if it was already efficient."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Compress PDF"
  initialStatus="Add a PDF file to compress."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> Scanned and image-heavy documents compress best.',
    '<strong>Pick a level.</strong> Screen (100 DPI) for forms and email, Balanced (150 DPI) for everyday reading, Print (200 DPI) when detail matters.',
    '<strong>Press Compress PDF.</strong> Each page is rebuilt at your chosen resolution on your device.',
    '<strong>Compare and download.</strong> If the result is not smaller than the original, the tool says so instead of handing you a bigger file.',
  ]}
  goodToKnow="Honest mechanics: this rebuilds pages as efficient images, which is exactly what makes scanned PDFs shrink dramatically — and it means text in the result is part of the picture, not selectable. A PDF that is already mostly text may not shrink at all; the tool checks the result size first and refuses to give you a larger file dressed up as a compression."
  faqs={[
    { q: 'Why did my PDF not get smaller?', a: 'Text-based PDFs are already compact — there is little fat to trim. Scanned documents and photo-heavy files hold the savings. The tool tells you plainly when the original wins.' },
    { q: 'Which level gets me under 200 KB?', a: 'Start with Screen (100 DPI). Short documents usually land well under form limits; long scans may need the form’s per-file rules checked as well.' },
    { q: 'Will the compressed PDF still print well?', a: 'Balanced suits normal reading and Print (200 DPI) suits office printing. Screen level is for screens and forms, not for fine print.' },
    { q: 'Is my document uploaded to be compressed?', a: 'Never. The rebuild happens in your browser; the file never leaves your device.' },
  ]}
>
  <div slot="options" class="options">
    <label>Compression level
      <select id="level">
        <option value="100:0.6">Screen · 100 DPI · smallest</option>
        <option value="150:0.72" selected>Balanced · 150 DPI</option>
        <option value="200:0.82">Print · 200 DPI · best quality</option>
      </select>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/compress-pdf.ts';</script>
