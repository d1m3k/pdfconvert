---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'delete-pdf-pages')!;
---
<ToolPage
  tool={tool}
  title="Delete PDF Pages — Remove Pages From a PDF Free | PdfConvert"
  description="Remove unwanted pages from a PDF by typing their numbers or ranges. Free, instant and private: the trimming happens in your browser, never on a server."
  lede="Blank pages, a cover sheet you do not need, last month's appendix — type the pages to remove and save the leaner document."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Delete pages"
  initialStatus="Add a PDF file to remove pages from."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> The tool reads it and reports the real page count.',
    '<strong>Type the pages to remove.</strong> Single pages and ranges both work: 2, 5-7, 12.',
    '<strong>Press Delete pages.</strong> The unwanted pages are removed in your browser.',
    '<strong>Download</strong> the trimmed document and check nothing needed went missing.',
  ]}
  goodToKnow="At least one page must survive — a PDF with zero pages is not a PDF, so the tool refuses a list that would delete everything. Remaining pages keep their original content, quality and order. Prefer to <em>see</em> the pages before deleting? The Organize PDF tool shows thumbnails you can delete visually."
  faqs={[
    { q: 'Can I delete several separate pages at once?', a: 'Yes — list them with commas and mix single pages with ranges, for example 1, 4-6, 9.' },
    { q: 'Can I undo a deletion?', a: 'Your original file is never modified, so just run the tool again on the original if the result is not what you wanted.' },
    { q: 'What if I only need a few pages and want to drop the rest?', a: 'Use Split PDF with ranges instead — it extracts exactly the pages you name into their own file.' },
    { q: 'Is my document uploaded?', a: 'Never. Deletion happens locally in your browser tab.' },
  ]}
>
  <div slot="options" class="options">
    <label>Pages to delete
      <input type="text" id="pages" placeholder="e.g. 2, 5-7, 12" size="22" />
      <span class="hint">Counted from 1, like your PDF reader</span>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/delete-pages.ts';</script>
