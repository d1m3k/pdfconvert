---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'rotate-pdf')!;
---
<ToolPage
  tool={tool}
  title="Rotate PDF — Turn Pages 90° or 180° Free | PdfConvert"
  description="Rotate PDF pages permanently: all pages, odd or even pages, or only the sideways ones. Free and private — rotation happens in your browser, never on a server."
  lede="Scanned a document sideways? Turn every page — or only the ones that need it — and save the corrected PDF for good."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Rotate PDF"
  initialStatus="Add a PDF file to rotate."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> Drop the document with the sideways pages into the box above.',
    '<strong>Pick a direction.</strong> Rotate 90° clockwise, 90° counter-clockwise, or flip 180°.',
    '<strong>Choose which pages.</strong> All pages, odd pages, even pages, or only landscape / portrait pages.',
    '<strong>Press Rotate PDF and download</strong> the corrected document — the rotation is saved into the file itself.',
  ]}
  goodToKnow="The rotation is written into each page's permanent settings, so the document opens upright in every reader afterwards — this is not a temporary view rotation. Pages that already carried a rotation keep it and are turned relative to where they started."
  faqs={[
    { q: 'Is the rotation permanent?', a: 'Yes. It is saved into the PDF file itself, so anyone who opens the result sees the pages upright.' },
    { q: 'Can I rotate just the sideways scans in a mixed document?', a: 'Yes — choose "only landscape pages" or "only portrait pages" and the rest of the document is left untouched.' },
    { q: 'Does rotating change the content or quality?', a: 'No. Only the page orientation flag changes; the page content is copied exactly.' },
    { q: 'Is my file uploaded anywhere?', a: 'No. The rotation is applied by your browser on your device.' },
  ]}
>
  <div slot="options" class="options">
    <label>Direction
      <select id="angle">
        <option value="90" selected>90° clockwise</option>
        <option value="-90">90° counter-clockwise</option>
        <option value="180">180° (upside down)</option>
      </select>
    </label>
    <label>Apply to
      <select id="scope">
        <option value="all" selected>All pages</option>
        <option value="odd">Odd pages (1, 3, 5…)</option>
        <option value="even">Even pages (2, 4, 6…)</option>
        <option value="landscape">Only landscape pages</option>
        <option value="portrait">Only portrait pages</option>
      </select>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/rotate.ts';</script>
