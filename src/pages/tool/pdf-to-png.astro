---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'pdf-to-png')!;
---
<ToolPage
  tool={tool}
  title="PDF to PNG — Export PDF Pages as PNG Images Free | PdfConvert"
  description="Export PDF pages as lossless PNG images in your browser. Pick 150, 200 or 300 DPI and download pages one by one or as a ZIP. Private by design: no uploads."
  lede="Export pages as PNG when sharp lines and exact text edges matter — slides, diagrams, receipts and screenshots of documents."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Convert to PNG"
  initialStatus="Add a PDF file to convert."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> Each page becomes one PNG image.',
    '<strong>Choose a resolution.</strong> PNG files are lossless, so higher DPI grows them quickly — 200 is a sensible default.',
    '<strong>Press Convert to PNG.</strong> Your browser renders each page and lists it for download.',
    '<strong>Download</strong> the pages you need, or everything as one ZIP.',
  ]}
  goodToKnow="PNG is lossless: text and line art stay perfectly sharp, at the cost of larger files than JPG for photo-heavy pages. If a page is mostly a photograph, PDF to JPG will give you a file a fraction of the size with no visible difference."
  faqs={[
    { q: 'PNG or JPG — which should I pick?', a: 'PNG for text, slides and diagrams where edges must stay crisp; JPG for pages dominated by photos, where PNG only adds weight.' },
    { q: 'Why are my PNGs so large?', a: 'Lossless pixels cost bytes, especially at 300 DPI. Drop to 150–200 DPI, or switch photo pages to JPG.' },
    { q: 'Can I get a transparent background?', a: 'Pages render over transparency where the PDF itself has none painted — most documents paint white, so exports normally come out on white.' },
    { q: 'Is anything uploaded?', a: 'Nothing. Conversion runs entirely in your browser tab.' },
  ]}
>
  <div slot="options" class="options">
    <label>Resolution
      <select id="dpi">
        <option value="150">150 DPI · screen</option>
        <option value="200" selected>200 DPI · sharp</option>
        <option value="300">300 DPI · maximum detail</option>
      </select>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/pdf-to-png.ts';</script>
