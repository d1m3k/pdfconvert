---
import ToolPage from '../../layouts/ToolPage.astro';
import { TOOLS } from '../../config/site';
const tool = TOOLS.find(t => t.slug === 'add-watermark')!;
---
<ToolPage
  tool={tool}
  title="Add Watermark to PDF — Stamp Text on Every Page Free | PdfConvert"
  description="Stamp CONFIDENTIAL, DRAFT or your own text diagonally across every page of a PDF, in your browser. Adjustable size and transparency. No uploads, no sign-up."
  lede="Brand a draft, mark a document confidential, or stamp copies before they travel — one diagonal watermark across every page."
  acceptAttr="application/pdf,.pdf"
  dropTitle="Drop a PDF file here"
  dropHint="or click to choose it from your device · PDF only · processed locally"
  ctaLabel="Add watermark"
  initialStatus="Add a PDF file to watermark."
  multiple={false}
  steps={[
    '<strong>Add your PDF.</strong> The watermark lands on every page, so check page one speaks for all.',
    '<strong>Type the watermark text</strong> — CONFIDENTIAL, DRAFT, your company name, anything.',
    '<strong>Set size and transparency.</strong> Subtle (15%) for working drafts, bolder for copies leaving the building.',
    '<strong>Press Add watermark and download</strong> the stamped document.',
  ]}
  goodToKnow="The text is drawn onto each page at a 45° angle in mid-grey, sized to sit across the page's middle. Because it becomes part of the page content, it prints with the document and cannot be switched off in a reader — that is the point of a watermark. Keep your unwatermarked original if you might need a clean copy later."
  faqs={[
    { q: 'Can the watermark be removed later?', a: 'Not easily — it is baked into every page. Always keep the clean original if removal might be needed.' },
    { q: 'Can I watermark with a logo image?', a: 'This tool stamps text, which covers most office needs. Image watermarks are on the roadmap.' },
    { q: 'Does it stamp only some pages?', a: 'It stamps every page evenly — split the PDF first if only part of the document needs marking.' },
    { q: 'Is my document uploaded?', a: 'No, the stamping happens in your browser tab.' },
  ]}
>
  <div slot="options" class="options">
    <label>Watermark text
      <input type="text" id="wmtext" value="CONFIDENTIAL" size="20" />
    </label>
    <label>Text size
      <select id="size">
        <option value="40">Small</option>
        <option value="60" selected>Medium</option>
        <option value="84">Large</option>
      </select>
    </label>
    <label>Transparency
      <select id="opacity">
        <option value="0.15">Subtle · 15%</option>
        <option value="0.25" selected>Standard · 25%</option>
        <option value="0.4">Bold · 40%</option>
      </select>
    </label>
  </div>
</ToolPage>
<script>import '../../scripts/watermark.ts';</script>
