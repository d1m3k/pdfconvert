---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Blog — Guides & Explainers | PdftConvert" description="Practical guides on working with PDFs and images: tutorials for every tool, fixes for file-size limits, and plain-language explainers.">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Blog</p>
      <h1>Guides &amp; explainers</h1>
      <p class="lede">One practical article at a time: how to get a file job done, why formats behave the way they do, and how to stay under upload limits without wrecking quality.</p>
    </section>
    <div class="grid" style="padding-bottom:40px">
      <a class="postcard" href={`${base}/blog/how-to-merge-pdf-files`}>
        <span class="tag">Tutorial · PDF</span>
        <h3>How to Merge PDF Files Without Uploading Them Anywhere</h3>
        <p>Three safe ways to combine PDFs — and why the method that never sends your documents to a server is the one worth trusting with contracts and ID scans.</p>
      </a>
    </div>
  </div>
</Base>
