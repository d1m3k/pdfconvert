---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = [
  { slug: 'how-to-merge-pdf-files', tag: 'Guide · PDF', title: 'How to Merge PDF Files Without Uploading Them Anywhere', blurb: 'Upload-based tools keep a copy of your documents on someone else\'s server. Merging in your browser removes that risk entirely — here is how it works and when it matters.' },
  { slug: 'shrink-pdf-below-200kb', tag: 'Guide · PDF', title: 'How to Shrink a PDF Below 200 KB for an Upload Form', blurb: 'Diagnose why the file is fat first — too many pages, heavy scans, or one giant image — then apply the cure that actually fits, all in your browser.' },
  { slug: 'png-vs-jpg-vs-webp', tag: 'Explainer · Images', title: 'PNG vs JPG vs WebP: Which Image Format Should You Use?', blurb: 'The same photo can weigh 14 MB or 1.2 MB depending on one choice. A plain-language guide to picking the right format in ten seconds.' },
];
---
<Base title="Blog — Guides & Explainers | PdfConvert" description="Practical guides for everyday file work: merging PDFs privately, shrinking files under upload limits, choosing image formats, and more — from PdfConvert.">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">The PdfConvert blog</p>
      <h1>Guides & explainers</h1>
      <p class="lede">Short, practical reading for the file chores everyone meets: forms that reject your PDF, photos too big to send, formats nobody explained. One new article every day.</p>
    </section>
    <div class="grid" style="padding-bottom:20px">
      {posts.map(p => (
        <a class="toolcard" href={`${base}/blog/${p.slug}`}>
          <span class="tag">{p.tag}</span>
          <h3 style="text-transform:none">{p.title}</h3>
          <p>{p.blurb}</p>
          <span class="go">Read →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
